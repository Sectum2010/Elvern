{
  "name": "elvern-frontend",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && node scripts/stamp-offline-shell.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:qa": "playwright test",
    "ui:qa:headed": "playwright test --headed",
    "playwright:install:extra": "node scripts/install-playwright-extra-browsers.mjs",
    "build:phase7": "node scripts/build-phase7-production.mjs",
    "test:e2e:revision-chromium": "node scripts/run-cross-browser-playwright.mjs --project chromium-desktop-production --project chromium-assistant-navigation --project chromium-settings-navigation --project chromium-service-worker-network-guard --project chromium-wss-network-guard",
    "test:e2e:control-center-baseline": "node scripts/run-cross-browser-playwright.mjs --project chromium-control-center-baseline",
    "visual:update:control-center": "ELVERN_UPDATE_CONTROL_CENTER_BASELINES=1 node scripts/run-cross-browser-playwright.mjs --project chromium-control-center-source-generation",
    "test:e2e:firefox": "node scripts/run-cross-browser-playwright.mjs --project firefox-desktop-production --project firefox-assistant-navigation --project firefox-settings-navigation --project firefox-service-worker-network-guard --project firefox-wss-network-guard",
    "test:e2e:webkit": "node scripts/run-cross-browser-playwright.mjs --project webkit-desktop-production",
    "test:e2e:cross-browser": "node scripts/run-cross-browser-playwright.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve": "node server.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "hls.js": "^1.6.15",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^24.1.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
