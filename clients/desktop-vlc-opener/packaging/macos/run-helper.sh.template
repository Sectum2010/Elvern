#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
HELPER_BIN="${APP_DIR}/app/Elvern.VlcOpener"
LOG_DIR="${HOME}/Library/Logs/ElvernVlcOpener"
LOG_FILE="${LOG_DIR}/opener.log"

mkdir -p "${LOG_DIR}"
exec >>"${LOG_FILE}" 2>&1

echo
echo "[$(date '+%Y-%m-%d %H:%M:%S')] macOS helper bridge invoked"
echo "argc=$#"
if [[ $# -gt 0 ]]; then
  echo "arg1=$1"
fi
if [[ $# -lt 1 ]]; then
  echo "No handoff URL argument was received by the helper bridge."
  exit 1
fi
if [[ ! -x "${HELPER_BIN}" ]]; then
  echo "Missing self-contained Elvern VLC Opener payload."
  exit 1
fi
exec "${HELPER_BIN}" "$@"
