<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ElvernHelperVersion>0.9.0</ElvernHelperVersion>
    <Version>$(ElvernHelperVersion)</Version>
    <FileVersion>$(ElvernHelperVersion).0</FileVersion>
    <InformationalVersion>$(ElvernHelperVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
